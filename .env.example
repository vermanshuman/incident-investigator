# --- LLM -------------------------------------------------------------
# Free path: LLM_PROVIDER=gemini with an AI Studio key (free tier).
LLM_PROVIDER=anthropic            # anthropic | openai | gemini
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Optional overrides (defaults per provider: anthropic=claude-opus-5/claude-haiku-4-5,
# openai=gpt-4o/gpt-4o-mini, gemini=gemini-2.5-pro/gemini-2.5-flash)
#LLM_MODEL=claude-sonnet-5        # cheaper reasoning model
#LLM_MODEL_SMALL=claude-haiku-4-5 # triage
# Gemini defaults (both nodes): gemini-3.8-flash

# --- Postgres --------------------------------------------------------
POSTGRES_USER=investigator
POSTGRES_PASSWORD=investigator
POSTGRES_DB=investigator
DATABASE_URL=postgresql+psycopg://investigator:investigator@postgres:5432/investigator
# Read-only role used by the query_database tool (created by infra/db/init.sql)
DATABASE_URL_READONLY=postgresql+psycopg://investigator_ro:investigator_ro@postgres:5432/checkout

# --- Target app ------------------------------------------------------
TARGET_DATABASE_URL=postgresql+psycopg://investigator:investigator@postgres:5432/checkout
TARGET_APP_URL=http://target-app:8080
TARGET_REPO_PATH=/data/target-repo

# --- Redis -----------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Free replay -----------------------------------------------------
# Record one real run, then replay it forever with no API calls:
#   python investigate.py --record cassettes/s01.jsonl "..."
#   python investigate.py --replay cassettes/s01.jsonl "..."

# --- MCP -------------------------------------------------------------
MCP_SERVER_URL=http://mcp-server:8090/mcp

# --- GitHub ----------------------------------------------------------
# Approving a report opens an issue here. Leave blank and approval is a dry
# run: the flow works, nothing is posted.
GITHUB_TOKEN=                     # issues:write on this repo only, never sent to the model
GITHUB_REPO=owner/repo
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Auth ------------------------------------------------------------
SESSION_SECRET=change-me

# --- Billing (optional) ----------------------------------------------
# Without these a plan change is applied directly and flagged "simulated",
# so the billing flow is demonstrable with no Stripe account. Use test keys.
STRIPE_SECRET_KEY=                # sk_test_...
STRIPE_PRICE_PRO=                 # price_... for the Pro plan
STRIPE_WEBHOOK_SECRET=            # whsec_... ; without it webhooks are unverified
APP_BASE_URL=http://localhost:3000

# --- Agent budgets ---------------------------------------------------
# Hard cost cap per investigation: the run stops and reports what it has.
AGENT_MAX_COST_USD=0.10
AGENT_CHEAP_REPORT=0              # 1 = write the report with the small model too
AGENT_MAX_STEPS=12
AGENT_MAX_TOKENS=150000
AGENT_MAX_SECONDS=300
TOOL_TIMEOUT_SECONDS=20

# --- Observability ---------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=incident-investigator
